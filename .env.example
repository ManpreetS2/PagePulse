# PagePulse environment configuration
# Copy to .env and adjust as needed. The app runs fully with no .env file —
# no paid APIs or external services are required for core monitoring.

# ---------------------------------------------------------------------------
# Core (optional)
# ---------------------------------------------------------------------------

# HTTP port for the Node server (default: 3000).
PORT=3000

# Directory for the SQLite database file (default: ./data relative to cwd).
DATA_DIR=./data

# Override the SQLite file path. Tests set this to ":memory:".
# Leave unset for normal local use.
# PAGEPULSE_DB=

# Set to 1 to disable the background scheduler (useful in some test setups).
# PAGEPULSE_DISABLE_SCHEDULER=

# ---------------------------------------------------------------------------
# Optional email notifications (SMTP)
# ---------------------------------------------------------------------------
# If these are unset, email delivery is disabled. In-app alerts still work,
# and Settings shows that email is off.

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM="PagePulse <alerts@example.com>"
# NOTIFY_EMAIL_TO=you@example.com
